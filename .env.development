# ============================================================================
# 雷犀 AI 客服系统 - 开发环境配置
# ============================================================================
# 说明：此文件为开发环境专用配置
# 使用方式：cp .env.development .env
# ============================================================================

# ============================================================================
# 基础配置 (Base Configuration)
# ============================================================================

# 运行环境：development(开发)
NODE_ENV=development

# 后端服务端口（Backend API Port）
# 开发环境：3000
PORT=3000

# 前端开发服务器端口（Frontend Dev Server Port）
# 开发环境：8000（用于本地开发调试）
FRONTEND_PORT=8000

# 前端 API 基础 URL（Frontend API Base URL）
# 开发环境：完整的后端地址
# 示例：
# - 本地后端：http://localhost:3000/api/v1
# - Docker 后端：http://backend-service:3000/api/v1
# - 外部服务器：https://api.example.com/api/v1
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Nginx 对外端口（Nginx External Port）
# 开发环境：80（用于统一入口访问）
NGINX_PORT=80

# ============================================================================
# MySQL 数据库配置 (MySQL Database Configuration)
# ============================================================================

# MySQL 对外暴露端口（Host Port）
MYSQL_PORT=3307

# MySQL 主机地址（Host Address）
# Docker 内部使用服务名：mysql-service
MYSQL_HOST=mysql-service

# 数据库名称（Database Name）
MYSQL_DATABASE=aisystem

# 数据库用户名（Database User）
MYSQL_USER=aisystem

# 数据库用户密码（Database User Password）
# 开发环境：使用简单密码
MYSQL_PASSWORD=aisystem123

# 数据库 Root 密码（Database Root Password）
# 开发环境：使用简单密码
MYSQL_ROOT_PASSWORD=root123

# Prisma 数据库连接字符串（Prisma Connection String）
# Docker 内部连接
DATABASE_URL=mysql://aisystem:aisystem123@mysql-service:3306/aisystem?connection_limit=100&pool_timeout=30&connect_timeout=10

# 本地数据库连接字符串（Local Database Connection）
# 用于本地开发、Prisma 迁移、数据导入等
LOCAL_DATABASE_URL=mysql://aisystem:aisystem123@127.0.0.1:3306/aisystem?connection_limit=100&pool_timeout=30&connect_timeout=10

# ============================================================================
# Redis 缓存配置 (Redis Cache Configuration)
# ============================================================================

# Redis 主机地址（Host Address）
REDIS_HOST=redis-service

# Redis 对外暴露端口（Host Port）
REDIS_PORT=6379

# Redis 数据库编号（Database Number）
REDIS_DB=0

# Redis 密码（Password）
# 开发环境：使用简单密码
REDIS_PASSWORD=redis123

# Redis 连接字符串（Connection String）
REDIS_URL=redis://:redis123@redis-service:6379/0

# 幂等性锁/缓存过期时间（秒）
IDEMPOTENCY_TTL_SECONDS=300
IDEMPOTENCY_LOCK_TTL_SECONDS=300

# 是否在响应头中包含幂等性调试信息
# 开发环境：true
IDEMPOTENCY_DEBUG_HEADERS=true

# 考勤审批创建锁过期时间（秒）
ATTENDANCE_APPROVAL_LOCK_TTL_SECONDS=30

# ============================================================================
# MinIO 对象存储配置 (MinIO Object Storage Configuration)
# ============================================================================

# MinIO API 端口（API Port）
MINIO_API_PORT=9000

# MinIO 控制台端口（Console Port）
MINIO_CONSOLE_PORT=9001

# MinIO 服务地址（Endpoint）
MINIO_ENDPOINT=minio-service

# MinIO 端口（Port）
MINIO_PORT=9000

# 是否使用 SSL（Use SSL）
# 开发环境：false
MINIO_USE_SSL=false

# MinIO Root 用户名（Root User）
MINIO_ROOT_USER=minioadmin

# MinIO Root 密码（Root Password）
# 开发环境：使用简单密码
MINIO_ROOT_PASSWORD=minioadmin123

# MinIO 存储桶名称（Bucket Name）
MINIO_BUCKET=aisystem

# ============================================================================
# Qdrant 向量数据库配置 (Qdrant Vector Database Configuration)
# ============================================================================

# Qdrant HTTP API 端口（HTTP API Port）
QDRANT_PORT=6333

# Qdrant gRPC 端口（gRPC Port）
QDRANT_GRPC_PORT=6334

# Qdrant 服务地址（Service URL）
QDRANT_URL=http://qdrant-service:6333

# Qdrant API 密钥（API Key）
# 开发环境：使用简单密钥
QDRANT_API_KEY=qdrant123

# ============================================================================
# JWT 认证配置 (JWT Authentication Configuration)
# ============================================================================

# JWT 密钥（Secret Key）
# 开发环境：使用固定密钥
JWT_SECRET=8aaf253ea83f0d3ad5d6071014f916bb6a13b08e9a14e30e0b2521d2840ebe70

# JWT 过期时间（Expires In）
# 开发环境：2小时
JWT_EXPIRES_IN=2h

# ============================================================================
# 系统配置 (System Configuration)
# ============================================================================

# 登录失败锁定阈值（次数）
AUTH_LOCKOUT_THRESHOLD=5

# 登录失败锁定时长（秒）
AUTH_LOCKOUT_DURATION=900

# ============================================================================
# 日志配置 (Logging Configuration)
# ============================================================================

# 日志级别（Log Level）
# 开发环境：debug
LOG_LEVEL=debug

# 是否启用日志（Enable Logging）
LOG_ENABLED=true

# 日志存储路径（Log Storage Path）
LOG_PATH=storage/logs/

# 是否按天切割日志（Daily Rotation）
LOG_DAILY=true

# 日志保留天数（Retention Days）
# 开发环境：7天
LOG_SAVE_DAYS=7

# 是否记录登录日志（Login Logs）
LOG_LOGIN=true

# 是否记录操作日志（Operation Logs）
LOG_OPERATE=true

# 是否记录接口日志（API Logs）
# 开发环境：true（便于调试）
LOG_API=true

# 是否记录错误日志（Error Logs）
LOG_ERROR=true

# 是否记录系统日志（System Logs）
LOG_SYSTEM=true

# 是否记录聊天日志（Chat Logs）
LOG_CHAT=false

# 日志文件权限（File Permission）
LOG_FILE_PERMISSION=0644

# ============================================================================
# 邮件配置 (Email Configuration) - 开发环境可选
# ============================================================================

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=changeme_smtp
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME=雷犀AI客服系统
SMTP_USE_TLS=true

# ============================================================================
# 短信配置 (SMS Configuration) - 开发环境可选
# ============================================================================

SMS_PROVIDER=aliyun
SMS_API_KEY=changeme_sms_key
SMS_API_SECRET=changeme_sms_secret
SMS_SIGNATURE=雷犀科技
SMS_TEMPLATE_VERIFY_CODE=SMS_123456789
SMS_TEMPLATE_NOTIFICATION=SMS_987654321

# ============================================================================
# AI 配置 (AI Configuration) - 兜底配置
# ============================================================================
# 说明：AI配置已迁移到数据库后台管理（系统管理 > AI配置）
# 这里的配置仅作为兜底使用，当数据库中没有配置时才会使用
# 建议：在后台配置好AI后，这里可以留空或使用默认值

# OpenAI API Key（OpenAI API Key）
# 兜底配置：当数据库中没有配置时使用
OPENAI_API_KEY=sk-changeme

# OpenAI API Base URL（OpenAI API Base URL）
# 兜底配置：默认使用官方地址
OPENAI_API_BASE=https://api.openai.com/v1

# OpenAI 模型（OpenAI Model）
# 兜底配置：默认使用 gpt-3.5-turbo
OPENAI_MODEL=gpt-3.5-turbo

# OpenAI 最大 Token 数（Max Tokens）
# 兜底配置：默认 2000
OPENAI_MAX_TOKENS=2000

# OpenAI 温度参数（Temperature）
# 兜底配置：默认 0.7
OPENAI_TEMPERATURE=0.7

# ============================================================================
# 外部平台仿真服务配置 (Mock Service Configuration)
# ============================================================================

# Mock 服务端口（Mock Service Port）
# 开发环境：3888
MOCK_SERVICE_PORT=3888

# ============================================================================
# 性能监控配置 (Performance Monitoring Configuration)
# ============================================================================

# 是否启用性能监控（Enable Performance Monitoring）
# 开发环境：true（便于性能调优）
PERFORMANCE_MONITORING_ENABLED=true

# 慢查询阈值（毫秒）
SLOW_QUERY_THRESHOLD=200

# 慢接口阈值（毫秒）
SLOW_API_THRESHOLD=1000

# ============================================================================
# 安全配置 (Security Configuration)
# ============================================================================

# CORS 允许的源（CORS Allowed Origins）
# 开发环境：允许本地端口
CORS_ORIGINS=http://localhost:8000,http://localhost:3000,http://127.0.0.1:8000,http://127.0.0.1:3000

# 是否启用 CSRF 保护（Enable CSRF Protection）
# 开发环境：false（便于调试）
CSRF_ENABLED=false

# 是否启用请求限流（Enable Rate Limiting）
# 开发环境：false（便于测试）
RATE_LIMIT_ENABLED=false

# 请求限流窗口时间（秒）
RATE_LIMIT_WINDOW=60

# 请求限流最大次数
RATE_LIMIT_MAX=100

# ============================================================================
# 文件上传配置 (File Upload Configuration)
# ============================================================================

# 文件上传最大大小（字节）
# 50MB
MAX_FILE_SIZE=52428800

# 允许的文件类型（MIME Types）
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# ============================================================================
# 定时任务配置 (Scheduled Tasks Configuration)
# ============================================================================

# 是否启用定时任务（Enable Scheduled Tasks）
# 开发环境：false（避免干扰）
SCHEDULED_TASKS_ENABLED=false

# 日志清理定时任务（Cron Expression）
LOG_CLEANUP_CRON=0 0 2 * * *

# 数据归档定时任务（Cron Expression）
DATA_ARCHIVE_CRON=0 0 3 * * *

# ============================================================================
# 备份配置 (Backup Configuration)
# ============================================================================

# 是否启用自动备份（Enable Auto Backup）
# 开发环境：false
AUTO_BACKUP_ENABLED=false

# 备份存储路径（Backup Storage Path）
BACKUP_PATH=storage/backups/

# 备份保留天数（Backup Retention Days）
BACKUP_RETENTION_DAYS=7

# 备份定时任务（Cron Expression）
BACKUP_CRON=0 0 4 * * *

# ============================================================================
# 开发工具配置 (Development Tools Configuration)
# ============================================================================

# 是否启用 API 文档（Enable API Documentation）
# 开发环境：true
API_DOCS_ENABLED=true

# API 文档路径（API Documentation Path）
API_DOCS_PATH=/api-docs

# 是否启用调试模式（Enable Debug Mode）
# 开发环境：true
DEBUG_MODE=true

# 是否显示详细错误信息（Show Detailed Errors）
# 开发环境：true
SHOW_DETAILED_ERRORS=true
