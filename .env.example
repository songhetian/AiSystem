# =========================
# Base
# =========================
# One of: development / test / production
NODE_ENV=development

# Backend app port
PORT=3000

# Frontend dev server port
FRONTEND_PORT=8000

# =========================
# MySQL
# =========================
# Host port exposed to the local machine
MYSQL_PORT=3306
MYSQL_HOST=mysql-service
MYSQL_DATABASE=aisystem
MYSQL_USER=aisystem
MYSQL_PASSWORD=changeme_user
MYSQL_ROOT_PASSWORD=changeme_root

# Prisma connection string
DATABASE_URL=mysql://aisystem:changeme_user@mysql-service:3306/aisystem

# Local database connection used by root helper scripts on Windows / Linux / macOS.
# Recommended for local Prisma push / seed / schema.sql import.
LOCAL_DATABASE_URL=mysql://aisystem:changeme_user@127.0.0.1:3306/aisystem

# =========================
# Redis
# =========================
REDIS_HOST=redis-service
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=changeme_redis

# Keep REDIS_URL for clients that prefer a single connection string
REDIS_URL=redis://:changeme_redis@redis-service:6379/0

# Idempotency lock/cache TTL in seconds
IDEMPOTENCY_TTL_SECONDS=300
IDEMPOTENCY_LOCK_TTL_SECONDS=300

# Whether backend responses include x-idempotency-* debug headers
IDEMPOTENCY_DEBUG_HEADERS=true

# Attendance approval creation lock TTL in seconds
ATTENDANCE_APPROVAL_LOCK_TTL_SECONDS=30

# =========================
# MinIO
# =========================
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=minio-service
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme_minio
MINIO_BUCKET=aisystem

# =========================
# Qdrant
# =========================
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://qdrant-service:6333
QDRANT_API_KEY=changeme_qdrant

# =========================
# Auth
# =========================
# Replace in production with a strong random secret
JWT_SECRET=changeme_jwt_secret
JWT_EXPIRES_IN=2h
