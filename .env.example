# ============================================================================
# 雷犀 AI 客服系统 - 环境变量配置文件
# ============================================================================
# 说明：
# 1. 复制此文件为 .env 并根据实际环境修改配置
# 2. 所有配置项都有中文说明，请仔细阅读后修改
# 3. 生产环境请务必修改所有密码和密钥
# 4. Docker Compose 会自动读取 .env 文件中的配置
# ============================================================================

# ============================================================================
# 基础配置 (Base Configuration)
# ============================================================================

# 运行环境：development(开发) / test(测试) / production(生产)
NODE_ENV=development

# 后端服务端口（Backend API Port）
# 默认：3000，可根据需要修改
PORT=3000

# 前端开发服务器端口（Frontend Dev Server Port）
# 默认：8000，可根据需要修改
FRONTEND_PORT=8000

# Nginx 对外端口（Nginx External Port）
# 默认：80，生产环境建议使用 443（HTTPS）
NGINX_PORT=80

# ============================================================================
# MySQL 数据库配置 (MySQL Database Configuration)
# ============================================================================

# MySQL 对外暴露端口（Host Port）
# 默认：3306，如果本地已有 MySQL 服务，可改为 3307 等
MYSQL_PORT=3306

# MySQL 主机地址（Host Address）
# Docker 内部使用服务名：mysql-service
# 本地开发使用：127.0.0.1 或 localhost
MYSQL_HOST=mysql-service

# 数据库名称（Database Name）
MYSQL_DATABASE=aisystem

# 数据库用户名（Database User）
# 建议：生产环境使用专用用户，不要使用 root
MYSQL_USER=aisystem

# 数据库用户密码（Database User Password）
# 警告：生产环境必须修改为强密码！
MYSQL_PASSWORD=changeme_user

# 数据库 Root 密码（Database Root Password）
# 警告：生产环境必须修改为强密码！
MYSQL_ROOT_PASSWORD=changeme_root

# Prisma 数据库连接字符串（Prisma Connection String）
# 包含连接池配置：
# - connection_limit: 连接池最大连接数（推荐：50，支持高并发）
# - pool_timeout: 从连接池获取连接的最大等待时间（秒）
# - connect_timeout: 初始连接的最大等待时间（秒）
# 注意：Prisma 会自动管理最小连接数（约为 max 的 20%，即 10 个连接）
DATABASE_URL=mysql://aisystem:changeme_user@mysql-service:3306/aisystem?connection_limit=50&pool_timeout=30&connect_timeout=10

# 本地数据库连接字符串（Local Database Connection）
# 用于本地开发、Prisma 迁移、数据导入等
# Windows / Linux / macOS 本地开发时使用
LOCAL_DATABASE_URL=mysql://aisystem:changeme_user@127.0.0.1:3306/aisystem?connection_limit=50&pool_timeout=30&connect_timeout=10

# ============================================================================
# Redis 缓存配置 (Redis Cache Configuration)
# ============================================================================

# Redis 主机地址（Host Address）
# Docker 内部使用服务名：redis-service
# 本地开发使用：127.0.0.1 或 localhost
REDIS_HOST=redis-service

# Redis 对外暴露端口（Host Port）
# 默认：6379
REDIS_PORT=6379

# Redis 数据库编号（Database Number）
# 范围：0-15，默认使用 0
REDIS_DB=0

# Redis 密码（Password）
# 警告：生产环境必须修改为强密码！
REDIS_PASSWORD=changeme_redis

# Redis 连接字符串（Connection String）
# 格式：redis://[:password@]host:port/db
REDIS_URL=redis://:changeme_redis@redis-service:6379/0

# 幂等性锁/缓存过期时间（秒）
# 用于防止重复提交，默认 5 分钟
IDEMPOTENCY_TTL_SECONDS=300
IDEMPOTENCY_LOCK_TTL_SECONDS=300

# 是否在响应头中包含幂等性调试信息
# 开发环境：true，生产环境：false
IDEMPOTENCY_DEBUG_HEADERS=true

# 考勤审批创建锁过期时间（秒）
# 防止并发创建重复审批，默认 30 秒
ATTENDANCE_APPROVAL_LOCK_TTL_SECONDS=30

# ============================================================================
# MinIO 对象存储配置 (MinIO Object Storage Configuration)
# ============================================================================

# MinIO API 端口（API Port）
# 默认：9000
MINIO_API_PORT=9000

# MinIO 控制台端口（Console Port）
# 默认：9001，用于访问 MinIO Web 管理界面
MINIO_CONSOLE_PORT=9001

# MinIO 服务地址（Endpoint）
# Docker 内部使用服务名：minio-service
# 本地开发使用：127.0.0.1 或 localhost
MINIO_ENDPOINT=minio-service

# MinIO 端口（Port）
# 与 MINIO_API_PORT 保持一致
MINIO_PORT=9000

# 是否使用 SSL（Use SSL）
# 开发环境：false，生产环境：true（需配置证书）
MINIO_USE_SSL=false

# MinIO Root 用户名（Root User）
# 警告：生产环境必须修改！
MINIO_ROOT_USER=minioadmin

# MinIO Root 密码（Root Password）
# 警告：生产环境必须修改为强密码！至少 8 位
MINIO_ROOT_PASSWORD=changeme_minio

# MinIO 存储桶名称（Bucket Name）
# 用于存储文件的桶名称
MINIO_BUCKET=aisystem

# ============================================================================
# Qdrant 向量数据库配置 (Qdrant Vector Database Configuration)
# ============================================================================

# Qdrant HTTP API 端口（HTTP API Port）
# 默认：6333
QDRANT_PORT=6333

# Qdrant gRPC 端口（gRPC Port）
# 默认：6334
QDRANT_GRPC_PORT=6334

# Qdrant 服务地址（Service URL）
# Docker 内部使用：http://qdrant-service:6333
# 本地开发使用：http://127.0.0.1:6333
QDRANT_URL=http://qdrant-service:6333

# Qdrant API 密钥（API Key）
# 警告：生产环境必须修改为强密钥！
QDRANT_API_KEY=changeme_qdrant

# ============================================================================
# JWT 认证配置 (JWT Authentication Configuration)
# ============================================================================

# JWT 密钥（Secret Key）
# 警告：生产环境必须修改为强随机字符串！至少 32 位
# 可使用命令生成：openssl rand -base64 32
JWT_SECRET=changeme_jwt_secret

# JWT 过期时间（Expires In）
# 格式：数字+单位（s=秒, m=分钟, h=小时, d=天）
# 示例：2h=2小时, 7d=7天, 30m=30分钟
JWT_EXPIRES_IN=2h

# ============================================================================
# 系统配置 (System Configuration)
# ============================================================================

# 默认重置密码（Default Reset Password）
# 用户密码重置时的默认密码，建议定期更换
# 警告：生产环境必须修改为强密码！
DEFAULT_RESET_PASSWORD=Admin123456

# 登录失败锁定阈值（次数）
# 连续登录失败多少次后锁定账号，默认：5 次
AUTH_LOCKOUT_THRESHOLD=5

# 登录失败锁定时长（秒）
# 账号锁定后多久自动解锁，默认：900 秒（15 分钟）
AUTH_LOCKOUT_DURATION=900

# ============================================================================
# 日志配置 (Logging Configuration)
# ============================================================================

# 日志级别（Log Level）
# 可选值：debug / info / warn / error
# 开发环境：debug，生产环境：info 或 warn
LOG_LEVEL=info

# 是否启用日志（Enable Logging）
# true=启用，false=禁用
LOG_ENABLED=true

# 日志存储路径（Log Storage Path）
# 相对路径或绝对路径，默认：storage/logs/
LOG_PATH=storage/logs/

# 是否按天切割日志（Daily Rotation）
# true=按天切割，false=不切割（不推荐）
LOG_DAILY=true

# 日志保留天数（Retention Days）
# 0=永久保留，建议生产环境设置为 30-90 天
LOG_SAVE_DAYS=30

# 是否记录登录日志（Login Logs）
LOG_LOGIN=true

# 是否记录操作日志（Operation Logs）
LOG_OPERATE=true

# 是否记录接口日志（API Logs）
LOG_API=false

# 是否记录错误日志（Error Logs）
LOG_ERROR=true

# 是否记录系统日志（System Logs）
LOG_SYSTEM=true

# 是否记录聊天日志（Chat Logs）
# 注意：聊天日志可能包含敏感信息，谨慎开启
LOG_CHAT=false

# 日志文件权限（File Permission）
# Linux/macOS 系统适用，格式：0644
LOG_FILE_PERMISSION=0644

# ============================================================================
# 邮件配置 (Email Configuration) - 可选（暂未使用）
# ============================================================================
# 说明：当前系统暂未使用邮件功能，以下配置可以忽略
# 如需启用邮件通知功能，请配置以下参数

# SMTP 服务器地址（SMTP Host）
# 示例：smtp.gmail.com, smtp.qq.com, smtp.163.com
SMTP_HOST=smtp.example.com

# SMTP 服务器端口（SMTP Port）
# 常用端口：25（非加密）, 465（SSL）, 587（TLS）
SMTP_PORT=587

# SMTP 用户名（SMTP User）
# 通常是邮箱地址
SMTP_USER=noreply@example.com

# SMTP 密码（SMTP Password）
# 某些邮箱服务需要使用授权码而非登录密码
SMTP_PASSWORD=changeme_smtp

# 发件人邮箱（From Email）
SMTP_FROM=noreply@example.com

# 发件人名称（From Name）
SMTP_FROM_NAME=雷犀AI客服系统

# 是否使用 TLS（Use TLS）
# true=使用 TLS 加密，false=不使用
SMTP_USE_TLS=true

# ============================================================================
# 短信配置 (SMS Configuration) - 可选（暂未使用）
# ============================================================================
# 说明：当前系统暂未使用短信功能，以下配置可以忽略
# 如需启用短信通知功能，请配置以下参数

# 短信服务商（SMS Provider）
# 可选值：aliyun / tencent / huawei / custom
SMS_PROVIDER=aliyun

# 短信 API Key（SMS API Key）
SMS_API_KEY=changeme_sms_key

# 短信 API Secret（SMS API Secret）
SMS_API_SECRET=changeme_sms_secret

# 短信签名（SMS Signature）
SMS_SIGNATURE=雷犀科技

# 短信模板 ID - 验证码（SMS Template ID - Verification Code）
SMS_TEMPLATE_VERIFY_CODE=SMS_123456789

# 短信模板 ID - 通知（SMS Template ID - Notification）
SMS_TEMPLATE_NOTIFICATION=SMS_987654321

# ============================================================================
# AI 配置 (AI Configuration) - 兜底配置（可选）
# ============================================================================
# 重要说明：
# 1. AI配置已迁移到数据库后台管理（系统管理 > AI配置）
# 2. 支持为不同部门配置不同的AI服务商和模型
# 3. 这里的配置仅作为兜底使用，当数据库中没有配置时才会使用
# 4. 建议：在后台配置好AI后，这里可以留空或使用默认值
# 5. 配置优先级：店铺 > 部门 > 平台 > 全局 > 环境变量（这里）

# OpenAI API Key（OpenAI API Key）
# 兜底配置：当数据库中没有任何AI配置时使用
# 留空或使用 sk-changeme 表示未配置
OPENAI_API_KEY=sk-changeme

# OpenAI API Base URL（OpenAI API Base URL）
# 兜底配置：默认使用官方地址
# 国内可使用代理或第三方服务
OPENAI_API_BASE=https://api.openai.com/v1

# OpenAI 模型（OpenAI Model）
# 兜底配置：默认使用 gpt-3.5-turbo
# 可选值：gpt-3.5-turbo / gpt-4 / gpt-4-turbo / gpt-4o-mini
OPENAI_MODEL=gpt-3.5-turbo

# OpenAI 最大 Token 数（Max Tokens）
# 兜底配置：默认 2000
OPENAI_MAX_TOKENS=2000

# OpenAI 温度参数（Temperature）
# 兜底配置：默认 0.7
# 范围：0-2，越高越随机，越低越确定
OPENAI_TEMPERATURE=0.7

# ============================================================================
# 外部平台仿真服务配置 (Mock Service Configuration) - 开发环境
# ============================================================================

# Mock 服务端口（Mock Service Port）
# 用于模拟外部平台 API，仅开发环境使用
MOCK_SERVICE_PORT=3888

# ============================================================================
# 性能监控配置 (Performance Monitoring Configuration) - 可选
# ============================================================================

# 是否启用性能监控（Enable Performance Monitoring）
PERFORMANCE_MONITORING_ENABLED=false

# 慢查询阈值（毫秒）
# 超过此时间的数据库查询会被记录
SLOW_QUERY_THRESHOLD=200

# 慢接口阈值（毫秒）
# 超过此时间的 API 请求会被记录
SLOW_API_THRESHOLD=1000

# ============================================================================
# 安全配置 (Security Configuration)
# ============================================================================

# CORS 允许的源（CORS Allowed Origins）
# 多个源用逗号分隔，* 表示允许所有源（不推荐生产环境使用）
CORS_ORIGINS=http://localhost:8000,http://localhost:3000

# 是否启用 CSRF 保护（Enable CSRF Protection）
CSRF_ENABLED=true

# 是否启用请求限流（Enable Rate Limiting）
RATE_LIMIT_ENABLED=true

# 请求限流窗口时间（秒）
RATE_LIMIT_WINDOW=60

# 请求限流最大次数
RATE_LIMIT_MAX=100

# ============================================================================
# 文件上传配置 (File Upload Configuration)
# ============================================================================

# 文件上传最大大小（字节）
# 10MB = 10485760, 50MB = 52428800, 100MB = 104857600
MAX_FILE_SIZE=52428800

# 允许的文件类型（MIME Types）
# 多个类型用逗号分隔
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# ============================================================================
# 定时任务配置 (Scheduled Tasks Configuration)
# ============================================================================

# 是否启用定时任务（Enable Scheduled Tasks）
SCHEDULED_TASKS_ENABLED=true

# 日志清理定时任务（Cron Expression）
# 格式：秒 分 时 日 月 周
# 示例：0 0 2 * * * = 每天凌晨 2 点执行
LOG_CLEANUP_CRON=0 0 2 * * *

# 数据归档定时任务（Cron Expression）
DATA_ARCHIVE_CRON=0 0 3 * * *

# ============================================================================
# 备份配置 (Backup Configuration) - 可选
# ============================================================================

# 是否启用自动备份（Enable Auto Backup）
AUTO_BACKUP_ENABLED=false

# 备份存储路径（Backup Storage Path）
BACKUP_PATH=storage/backups/

# 备份保留天数（Backup Retention Days）
BACKUP_RETENTION_DAYS=7

# 备份定时任务（Cron Expression）
# 示例：0 0 4 * * * = 每天凌晨 4 点执行
BACKUP_CRON=0 0 4 * * *

# ============================================================================
# 开发工具配置 (Development Tools Configuration) - 仅开发环境
# ============================================================================

# 是否启用 API 文档（Enable API Documentation）
# Swagger/OpenAPI 文档，生产环境建议关闭
API_DOCS_ENABLED=true

# API 文档路径（API Documentation Path）
API_DOCS_PATH=/api-docs

# 是否启用调试模式（Enable Debug Mode）
# 开发环境：true，生产环境：false
DEBUG_MODE=true

# 是否显示详细错误信息（Show Detailed Errors）
# 开发环境：true，生产环境：false（避免泄露敏感信息）
SHOW_DETAILED_ERRORS=true

# ============================================================================
# 注意事项 (Important Notes)
# ============================================================================
# 1. 生产环境部署前，请务必修改所有包含 "changeme" 的配置项
# 2. 所有密码和密钥建议使用强随机字符串（至少 16 位，包含大小写字母、数字、特殊字符）
# 3. 定期更换密码和密钥，提高系统安全性
# 4. 不要将 .env 文件提交到版本控制系统（已在 .gitignore 中排除）
# 5. 备份 .env 文件到安全位置，避免配置丢失
# 6. 如有疑问，请参考项目文档或联系技术支持
# ============================================================================
