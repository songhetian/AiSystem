# ============================================================================
# 雷犀 AI 客服系统 - 生产环境配置
# ============================================================================
# 说明：此文件为生产环境专用配置
# 使用方式：cp .env.production .env
# 警告：生产环境部署前，请务必修改所有包含 "changeme" 的配置项！
# ============================================================================

# ============================================================================
# 基础配置 (Base Configuration)
# ============================================================================

# 运行环境：production(生产)
NODE_ENV=production

# 后端服务端口（Backend API Port）
# 生产环境：3000（内部端口，通过 Nginx 代理）
PORT=3000

# 前端服务端口（Frontend Server Port）
# 生产环境：8000（内部端口，通过 Nginx 代理）
FRONTEND_PORT=8000

# 前端 API 基础 URL（Frontend API Base URL）
# 生产环境：完整的后端地址
# 示例：
# - 生产服务器：https://api.yourdomain.com/api/v1
# - 内网地址：http://backend-service:3000/api/v1
# - 外部服务器：https://external-api.example.com/api/v1
VITE_API_BASE_URL=https://api.yourdomain.com/api/v1

# Nginx 对外端口（Nginx External Port）
# 生产环境：80（HTTP）或 443（HTTPS，需配置 SSL 证书）
NGINX_PORT=80

# ============================================================================
# MySQL 数据库配置 (MySQL Database Configuration)
# ============================================================================

# MySQL 对外暴露端口（Host Port）
# 生产环境建议：不对外暴露，仅 Docker 内部访问
# 如需外部访问，可改为 3307 等非标准端口
MYSQL_PORT=3306

# MySQL 主机地址（Host Address）
# Docker 内部使用服务名：mysql-service
# 如使用外部数据库，填写实际 IP 或域名
MYSQL_HOST=mysql-service

# 数据库名称（Database Name）
MYSQL_DATABASE=aisystem

# 数据库用户名（Database User）
# 生产环境：使用专用用户，不要使用 root
MYSQL_USER=aisystem

# 数据库用户密码（Database User Password）
# 警告：生产环境必须修改为强密码！
# 建议：至少 16 位，包含大小写字母、数字、特殊字符
MYSQL_PASSWORD=changeme_user_prod

# 数据库 Root 密码（Database Root Password）
# 警告：生产环境必须修改为强密码！
MYSQL_ROOT_PASSWORD=changeme_root_prod

# Prisma 数据库连接字符串（Prisma Connection String）
# Docker 内部连接
DATABASE_URL=mysql://aisystem:changeme_user_prod@mysql-service:3306/aisystem?connection_limit=100&pool_timeout=30&connect_timeout=10

# 本地数据库连接字符串（Local Database Connection）
# 用于本地管理、Prisma 迁移、数据导入等
LOCAL_DATABASE_URL=mysql://aisystem:changeme_user_prod@127.0.0.1:3306/aisystem?connection_limit=100&pool_timeout=30&connect_timeout=10

# ============================================================================
# Redis 缓存配置 (Redis Cache Configuration)
# ============================================================================

# Redis 主机地址（Host Address）
REDIS_HOST=redis-service

# Redis 对外暴露端口（Host Port）
REDIS_PORT=6379

# Redis 数据库编号（Database Number）
REDIS_DB=0

# Redis 密码（Password）
# 警告：生产环境必须修改为强密码！
REDIS_PASSWORD=changeme_redis_prod

# Redis 连接字符串（Connection String）
REDIS_URL=redis://:changeme_redis_prod@redis-service:6379/0

# 幂等性锁/缓存过期时间（秒）
IDEMPOTENCY_TTL_SECONDS=300
IDEMPOTENCY_LOCK_TTL_SECONDS=300

# 是否在响应头中包含幂等性调试信息
# 生产环境：false（避免泄露信息）
IDEMPOTENCY_DEBUG_HEADERS=false

# 考勤审批创建锁过期时间（秒）
ATTENDANCE_APPROVAL_LOCK_TTL_SECONDS=30

# ============================================================================
# MinIO 对象存储配置 (MinIO Object Storage Configuration)
# ============================================================================

# MinIO API 端口（API Port）
MINIO_API_PORT=9000

# MinIO 控制台端口（Console Port）
MINIO_CONSOLE_PORT=9001

# MinIO 服务地址（Endpoint）
MINIO_ENDPOINT=minio-service

# MinIO 端口（Port）
MINIO_PORT=9000

# 是否使用 SSL（Use SSL）
# 生产环境：true（需配置证书）
MINIO_USE_SSL=false

# MinIO Root 用户名（Root User）
# 警告：生产环境必须修改！
MINIO_ROOT_USER=changeme_minio_user

# MinIO Root 密码（Root Password）
# 警告：生产环境必须修改为强密码！至少 8 位
MINIO_ROOT_PASSWORD=changeme_minio_prod

# MinIO 存储桶名称（Bucket Name）
MINIO_BUCKET=aisystem

# ============================================================================
# Qdrant 向量数据库配置 (Qdrant Vector Database Configuration)
# ============================================================================

# Qdrant HTTP API 端口（HTTP API Port）
QDRANT_PORT=6333

# Qdrant gRPC 端口（gRPC Port）
QDRANT_GRPC_PORT=6334

# Qdrant 服务地址（Service URL）
QDRANT_URL=http://qdrant-service:6333

# Qdrant API 密钥（API Key）
# 警告：生产环境必须修改为强密钥！
QDRANT_API_KEY=changeme_qdrant_prod

# ============================================================================
# JWT 认证配置 (JWT Authentication Configuration)
# ============================================================================

# JWT 密钥（Secret Key）
# 警告：生产环境必须修改为强随机字符串！至少 32 位
# 可使用命令生成：openssl rand -base64 32
JWT_SECRET=changeme_jwt_secret_prod

# JWT 过期时间（Expires In）
# 生产环境：2小时（可根据安全需求调整）
JWT_EXPIRES_IN=2h

# ============================================================================
# 系统配置 (System Configuration)
# ============================================================================

# 登录失败锁定阈值（次数）
# 生产环境：5次（可根据安全需求调整）
AUTH_LOCKOUT_THRESHOLD=5

# 登录失败锁定时长（秒）
# 生产环境：900秒（15分钟）
AUTH_LOCKOUT_DURATION=900

# ============================================================================
# 日志配置 (Logging Configuration)
# ============================================================================

# 日志级别（Log Level）
# 生产环境：info 或 warn
LOG_LEVEL=info

# 是否启用日志（Enable Logging）
LOG_ENABLED=true

# 日志存储路径（Log Storage Path）
LOG_PATH=storage/logs/

# 是否按天切割日志（Daily Rotation）
LOG_DAILY=true

# 日志保留天数（Retention Days）
# 生产环境：30-90天
LOG_SAVE_DAYS=30

# 是否记录登录日志（Login Logs）
LOG_LOGIN=true

# 是否记录操作日志（Operation Logs）
LOG_OPERATE=true

# 是否记录接口日志（API Logs）
# 生产环境：false（避免日志过大）
LOG_API=false

# 是否记录错误日志（Error Logs）
LOG_ERROR=true

# 是否记录系统日志（System Logs）
LOG_SYSTEM=true

# 是否记录聊天日志（Chat Logs）
# 注意：聊天日志可能包含敏感信息，谨慎开启
LOG_CHAT=false

# 日志文件权限（File Permission）
LOG_FILE_PERMISSION=0644

# ============================================================================
# 邮件配置 (Email Configuration) - 生产环境必须配置
# ============================================================================

# SMTP 服务器地址（SMTP Host）
# 示例：smtp.gmail.com, smtp.qq.com, smtp.163.com
SMTP_HOST=smtp.example.com

# SMTP 服务器端口（SMTP Port）
# 常用端口：25（非加密）, 465（SSL）, 587（TLS）
SMTP_PORT=587

# SMTP 用户名（SMTP User）
SMTP_USER=noreply@example.com

# SMTP 密码（SMTP Password）
# 某些邮箱服务需要使用授权码而非登录密码
SMTP_PASSWORD=changeme_smtp_prod

# 发件人邮箱（From Email）
SMTP_FROM=noreply@example.com

# 发件人名称（From Name）
SMTP_FROM_NAME=雷犀AI客服系统

# 是否使用 TLS（Use TLS）
SMTP_USE_TLS=true

# ============================================================================
# 短信配置 (SMS Configuration) - 生产环境必须配置
# ============================================================================

# 短信服务商（SMS Provider）
SMS_PROVIDER=aliyun

# 短信 API Key（SMS API Key）
SMS_API_KEY=changeme_sms_key_prod

# 短信 API Secret（SMS API Secret）
SMS_API_SECRET=changeme_sms_secret_prod

# 短信签名（SMS Signature）
SMS_SIGNATURE=雷犀科技

# 短信模板 ID - 验证码（SMS Template ID - Verification Code）
SMS_TEMPLATE_VERIFY_CODE=SMS_123456789

# 短信模板 ID - 通知（SMS Template ID - Notification）
SMS_TEMPLATE_NOTIFICATION=SMS_987654321

# ============================================================================
# AI 配置 (AI Configuration) - 兜底配置（可选）
# ============================================================================
# 重要说明：
# 1. AI配置已迁移到数据库后台管理（系统管理 > AI配置）
# 2. 支持为不同部门配置不同的AI服务商和模型
# 3. 这里的配置仅作为兜底使用，当数据库中没有配置时才会使用
# 4. 生产环境建议：在后台配置好AI，这里留空或使用默认值
# 5. 配置优先级：店铺 > 部门 > 平台 > 全局 > 环境变量（这里）

# OpenAI API Key（OpenAI API Key）
# 兜底配置：当数据库中没有任何AI配置时使用
# 警告：生产环境必须修改为实际的API Key！
OPENAI_API_KEY=changeme_openai_key_prod

# OpenAI API Base URL（OpenAI API Base URL）
# 兜底配置：默认使用官方地址
OPENAI_API_BASE=https://api.openai.com/v1

# OpenAI 模型（OpenAI Model）
# 兜底配置：默认使用 gpt-3.5-turbo
OPENAI_MODEL=gpt-3.5-turbo

# OpenAI 最大 Token 数（Max Tokens）
# 兜底配置：默认 2000
OPENAI_MAX_TOKENS=2000

# OpenAI 温度参数（Temperature）
# 兜底配置：默认 0.7
OPENAI_TEMPERATURE=0.7

# ============================================================================
# 外部平台仿真服务配置 (Mock Service Configuration)
# ============================================================================

# Mock 服务端口（Mock Service Port）
# 生产环境：不启用（仅开发环境使用）
MOCK_SERVICE_PORT=3888

# ============================================================================
# 性能监控配置 (Performance Monitoring Configuration)
# ============================================================================

# 是否启用性能监控（Enable Performance Monitoring）
# 生产环境：true
PERFORMANCE_MONITORING_ENABLED=true

# 慢查询阈值（毫秒）
SLOW_QUERY_THRESHOLD=200

# 慢接口阈值（毫秒）
SLOW_API_THRESHOLD=1000

# ============================================================================
# 安全配置 (Security Configuration)
# ============================================================================

# CORS 允许的源（CORS Allowed Origins）
# 生产环境：仅允许实际域名，不要使用 *
# 示例：https://www.example.com,https://admin.example.com
CORS_ORIGINS=https://www.example.com

# 是否启用 CSRF 保护（Enable CSRF Protection）
# 生产环境：true
CSRF_ENABLED=true

# 是否启用请求限流（Enable Rate Limiting）
# 生产环境：true
RATE_LIMIT_ENABLED=true

# 请求限流窗口时间（秒）
RATE_LIMIT_WINDOW=60

# 请求限流最大次数
RATE_LIMIT_MAX=100

# ============================================================================
# 文件上传配置 (File Upload Configuration)
# ============================================================================

# 文件上传最大大小（字节）
# 50MB
MAX_FILE_SIZE=52428800

# 允许的文件类型（MIME Types）
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# ============================================================================
# 定时任务配置 (Scheduled Tasks Configuration)
# ============================================================================

# 是否启用定时任务（Enable Scheduled Tasks）
# 生产环境：true
SCHEDULED_TASKS_ENABLED=true

# 日志清理定时任务（Cron Expression）
# 每天凌晨 2 点执行
LOG_CLEANUP_CRON=0 0 2 * * *

# 数据归档定时任务（Cron Expression）
# 每天凌晨 3 点执行
DATA_ARCHIVE_CRON=0 0 3 * * *

# ============================================================================
# 备份配置 (Backup Configuration)
# ============================================================================

# 是否启用自动备份（Enable Auto Backup）
# 生产环境：true
AUTO_BACKUP_ENABLED=true

# 备份存储路径（Backup Storage Path）
BACKUP_PATH=storage/backups/

# 备份保留天数（Backup Retention Days）
BACKUP_RETENTION_DAYS=30

# 备份定时任务（Cron Expression）
# 每天凌晨 4 点执行
BACKUP_CRON=0 0 4 * * *

# ============================================================================
# 开发工具配置 (Development Tools Configuration)
# ============================================================================

# 是否启用 API 文档（Enable API Documentation）
# 生产环境：false（避免泄露接口信息）
API_DOCS_ENABLED=false

# API 文档路径（API Documentation Path）
API_DOCS_PATH=/api-docs

# 是否启用调试模式（Enable Debug Mode）
# 生产环境：false
DEBUG_MODE=false

# 是否显示详细错误信息（Show Detailed Errors）
# 生产环境：false（避免泄露敏感信息）
SHOW_DETAILED_ERRORS=false

# ============================================================================
# 生产环境部署检查清单
# ============================================================================
# [ ] 修改所有包含 "changeme" 的配置项
# [ ] 使用强密码（至少 16 位，包含大小写字母、数字、特殊字符）
# [ ] 配置 CORS_ORIGINS 为实际域名
# [ ] 启用 CSRF_ENABLED 和 RATE_LIMIT_ENABLED
# [ ] 关闭 API_DOCS_ENABLED 和 DEBUG_MODE
# [ ] 配置邮件和短信服务
# [ ] 设置 .env 文件权限：chmod 600 .env
# [ ] 备份 .env 文件到安全位置
# [ ] 配置 SSL 证书（如使用 HTTPS）
# [ ] 配置防火墙规则
# [ ] 配置数据库备份策略
# [ ] 配置日志监控和告警
# ============================================================================
