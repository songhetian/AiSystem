  id           String    @id @default(cuid())
  create_time  DateTime  @default(now())
  update_time  DateTime  @updatedAt
  is_deleted   Int       @default(0)
  name         String    @unique // e.g., ${username}
  biz_module   String    // user, order, service, interface
  description  String?
  platform_id  String
}

// [NEW] 排班历史表 - 替代 sys_config 存储排班历史
model attendance_schedule_history {
  id                  String   @id @default(cuid())
  create_time         DateTime @default(now())
  update_time         DateTime @updatedAt
  is_deleted          Int      @default(0)
  draft_name          String
  mode                String   // fairness, coverage
  platform_id         String
  dept_id             String
  start_date          DateTime @db.Date
  end_date            DateTime @db.Date
  total_scheduled     Int      @default(0)
  warning_count       Int      @default(0)
  compliance_rate     Int      @default(0)
  satisfaction_rate   Int      @default(0)
  fitting_rate        Int      @default(0)
  applied_by          String
  applied_at          DateTime
  items_count         Int      @default(0)
  schedule_data       Json?    // 详细排班数据
  config_params       Json?    // 生成时的配置参数
  remark              String?  @db.Text

  @@index([platform_id, dept_id, start_date, end_date])
  @@index([applied_at])
  @@index([mode])
}

// [NEW] 排班预测表 - 基于历史数据的智能预测
model attendance_schedule_prediction {
  id                      String   @id @default(cuid())
  create_time             DateTime @default(now())
  update_time             DateTime @updatedAt
  is_deleted              Int      @default(0)
  platform_id             String
  dept_id                 String
  predict_date            DateTime @db.Date
  shift_name              String
  predicted_demand        Int      @default(0)
  confidence_score        Decimal  @db.Decimal(5, 2) @default(0.00)
  based_on_history_count  Int      @default(0)
  avg_historical_demand   Decimal? @db.Decimal(10, 2)
  trend_factor            Decimal? @db.Decimal(5, 2)
  prediction_model        String   @default("simple_average")
  prediction_params       Json?
  actual_demand           Int?
  accuracy_rate           Decimal? @db.Decimal(5, 2)

  @@unique([dept_id, predict_date, shift_name, is_deleted], name: "unique_prediction")
  @@index([platform_id, dept_id, predict_date])
  @@index([confidence_score])
}

// [NEW V4.0] 异步排班任务队列表
model attendance_schedule_job {
  id              String   @id @default(cuid())
  create_time     DateTime @default(now())
  update_time     DateTime @updatedAt
  is_deleted      Int      @default(0)
  job_id          String   @unique
  user_id         String
  platform_id     String
  dept_id         String
  start_date      DateTime @db.Date
  end_date        DateTime @db.Date
  config_params   Json?
  status          String   @default("pending") // pending, processing, completed, failed
  progress        Int      @default(0)
  result          Json?
  error_message   String?  @db.Text
  started_at      DateTime?
  completed_at    DateTime?

  @@index([user_id, status, create_time])
  @@index([platform_id, dept_id, status])
}

// [NEW V4.0] AI推荐记录表
model attendance_schedule_recommendation {
  id                  String   @id @default(cuid())
  create_time         DateTime @default(now())
  update_time         DateTime @updatedAt
  is_deleted          Int      @default(0)
  platform_id         String
  dept_id             String
  recommendation_type String   // params, shifts, demands
  confidence_score    Decimal  @db.Decimal(5, 2) @default(0.00)
  recommendations     Json
  analysis_data       Json?
  applied             Int      @default(0)
  applied_at          DateTime?
  applied_by          String?

  @@index([platform_id, dept_id, recommendation_type, create_time])
  @@index([confidence_score])
}

// [NEW V4.0] 机器学习模型配置表
model attendance_schedule_ml_model {
  id              String   @id @default(cuid())
  create_time     DateTime @default(now())
  update_time     DateTime @updatedAt
  is_deleted      Int      @default(0)
  platform_id     String
  dept_id         String
  shift_name      String
  model_type      String   @default("simple_moving_average")
  model_params    Json
  training_data_count Int  @default(0)
  accuracy_rate   Decimal? @db.Decimal(5, 2)
  last_trained_at DateTime
  status          Int      @default(1)

  @@unique([platform_id, dept_id, shift_name, is_deleted])
  @@index([model_type, status])
}

// [NEW V4.0] 多目标优化结果表
model attendance_schedule_optimization_result {
  id              String   @id @default(cuid())
  create_time     DateTime @default(now())
  update_time     DateTime @updatedAt
  is_deleted      Int      @default(0)
  platform_id     String
  dept_id         String
  start_date      DateTime @db.Date
  end_date        DateTime @db.Date
  solution_id     String
  params          Json
  objectives      Json     // fairness, coverage, satisfaction, cost, compliance
  total_score     Decimal  @db.Decimal(10, 2)
  is_pareto_optimal Int    @default(0)
  schedule_data   Json?
  applied         Int      @default(0)
  applied_at      DateTime?
  applied_by      String?

  @@index([platform_id, dept_id, create_time])
  @@index([total_score])
  @@index([is_pareto_optimal])
}

// [NEW V4.0] 实时调整记录表
model attendance_schedule_realtime_adjustment {
  id              String   @id @default(cuid())
  create_time     DateTime @default(now())
  update_time     DateTime @updatedAt
  is_deleted      Int      @default(0)
  platform_id     String
  dept_id         String
  adjustment_date DateTime @db.Date
  adjustment_type String   // replacement, supplement, cancellation
  original_employee_id String?
  new_employee_id String?
  shift_name      String
  reason          String   @db.Text
  status          String   @default("pending") // pending, applied, rejected
  applied_at      DateTime?
  applied_by      String?

  @@index([platform_id, dept_id, adjustment_date, status])
  @@index([adjustment_type, create_time])
}

// 知识库接口监控配置表
model knowledge_interface_monitor {
  id              String   @id @default(cuid())
  create_time     DateTime @default(now())
