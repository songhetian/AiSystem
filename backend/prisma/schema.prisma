  update_time     DateTime @updatedAt
  is_deleted      Int      @default(0)
  resource_type   String   // module/menu/button
  resource_id     String
  resource_name   String
  need_control    Int      @default(1) // 1需要 0不需要
  exception_roles Json?    // 例外角色列表

  @@unique([resource_type, resource_id, is_deleted])
  @@index([resource_type, is_deleted])
  @@index([need_control, is_deleted])
