  manual_absent_reason String?  @db.LongText
  correct_count        Int      @default(0)
  question_count       Int      @default(0)
  platform_id          String
  dept_id              String
  shop_id              String?
  reminder_mode        String   @default("notice")
  force_enter          Int      @default(0)

  @@unique([plan_id, user_id])
  @@index([user_id, status, submitted_at])
  @@index([platform_id, dept_id, shop_id, status, submitted_at])
}

model knowledge_tag {
