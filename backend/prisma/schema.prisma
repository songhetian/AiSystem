  target_employee_ids Json?
  target_count        Int      @default(0)
  status              String   @default("draft")
  platform_id         String
  dept_id             String
  shop_id             String?
  created_by          String?

  @@index([paper_id])
  @@index([platform_id, dept_id, shop_id, start_time, end_time])
