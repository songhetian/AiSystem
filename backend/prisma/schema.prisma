  early_threshold       Int      @default(0)
  absenteeism_threshold Int      @default(0)
  color                 String?
  opacity               Int      @default(50)
  status                Int      @default(1)
  platform_id           String?
  dept_id               String?
}

model approval_event {
  id                  String   @id @default(cuid())
  create_time         DateTime @default(now())
  update_time         DateTime @updatedAt
  is_deleted          Int      @default(0)
  request_id          String
  request_no          String
  biz_type            String?
  biz_id              String?
