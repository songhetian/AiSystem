model biz_product_category {
  id            String   @id @default(cuid())
  create_time   DateTime @default(now())
  update_time   DateTime @updatedAt
  is_deleted    Int      @default(0)
  name          String
  code          String
  parent_id     String?
  level         Int      @default(1)
  sort          Int      @default(0)
  platform_id   String
  department_id String
  status        Int      @default(1)

  @@unique([code, platform_id, department_id])
}

model biz_product {
  id            String   @id @default(cuid())
  create_time   DateTime @default(now())
  update_time   DateTime @updatedAt
  is_deleted    Int      @default(0)
  name          String
  code          String   @unique
  category_id   String?
  description   String?  @db.Text
  images        Json?
  platform_id   String
  department_id String
  status        Int      @default(1)
  skus          biz_product_sku[]

  @@index([platform_id, department_id, status])
}

model biz_product_sku {
  id          String   @id @default(cuid())
  create_time DateTime @default(now())
  update_time DateTime @updatedAt
  is_deleted  Int      @default(0)
  product_id  String
  sku_code    String   @unique
  spec_data   Json?
  price       Decimal  @db.Decimal(10, 2)
  stock       Int      @default(0)
  warn_stock  Int      @default(5)
  sort        Int      @default(0)
  shop_id     String
  status      Int      @default(1)
  product     biz_product @relation(fields: [product_id], references: [id])

  @@index([shop_id, status])
}

model service_session {
  id                    String   @id @default(cuid())
  create_time           DateTime @default(now())
  update_time           DateTime @updatedAt
  is_deleted            Int      @default(0)
  session_no            String   @unique
  customer_id           String?
  customer_nickname     String?
  customer_satisfaction Int?
  agent_user_id         String?
  agent_name            String?
  group_name            String?
  platform_id           String
  dept_id               String
  shop_id               String?
  status                String   @default("pending")
  transfer_status       String   @default("none")
  started_at            DateTime
  ended_at              DateTime?
  first_response_at     DateTime?
  last_message_at       DateTime?
  response_duration_sec Int?
  tags                  Json?
  remark                String?  @db.Text
  messages              service_session_message[]

  @@index([platform_id, dept_id, shop_id, status])
  @@index([agent_user_id, started_at])
  @@index([shop_id, status])
  @@index([started_at, status])
}

model service_session_message {
  id           String   @id @default(cuid())
  create_time  DateTime @default(now())
  update_time  DateTime @updatedAt
  is_deleted   Int      @default(0)
  session_id   String
  session_no   String
  sender_type  String
  sender_id    String?
  sender_name  String?
  message_type String   @default("text")
  content      String   @db.Text
  attachments  Json?
  sent_at      DateTime
  platform_id  String
  dept_id      String
  shop_id      String?
  session      service_session @relation(fields: [session_id], references: [id])

  @@index([session_id, sent_at])
}

model service_quality_rule {
  id                   String   @id @default(cuid())
  create_time          DateTime @default(now())
  update_time          DateTime @updatedAt
  is_deleted           Int      @default(0)
  rule_name            String
  rule_type            String
