  missing_coverage_hours Decimal  @db.Decimal(10, 2)
  overlapping_hours      Decimal  @db.Decimal(10, 2)
  missing_details        Json?
  overlapping_details    Json?
  platform_id            String
  dept_id                String

  @@index([platform_id, dept_id, check_date])
}

model attendance_ai_config {
  id                  String   @id @default(cuid())
  create_time         DateTime @default(now())
  update_time         DateTime @updatedAt
  is_deleted          Int      @default(0)
  conflict_rules      Json?
  emp_preferences     Json?
  shift_priority      Json?
  algorithm_params    Json?
  ui_settings         Json?
  platform_id         String
  dept_id             String

  @@unique([platform_id, dept_id])
}

model sys_mapping_template {
  id              String   @id @default(cuid())
  create_time     DateTime @default(now())
  update_time     DateTime @updatedAt
  is_deleted      Int      @default(0)
  name            String
  data_type       String   // order, product, customer
  platform_id     String
  parent_id       String?  // [NEW] 父模版 ID，用于继承 (Section 4.4.2)
  mapping_rules   Json     // {"std_field": "external.path"}
  cleaning_rules  Json?    // {"field": "trim/lowercase/number"}
  is_public       Int      @default(1)
  created_by      String?
  status          Int      @default(1)

  parent          sys_mapping_template?  @relation("TemplateInheritance", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children        sys_mapping_template[] @relation("TemplateInheritance")

  @@index([platform_id, data_type, status])
}

model sys_platform_config {
  id              String   @id @default(cuid())
  create_time     DateTime @default(now())
  update_time     DateTime @updatedAt
  is_deleted      Int      @default(0)
  platform_id     String
  dept_id         String
  shop_id         String?
  template_id     String?  // 关联 sys_mapping_template
  app_key         String?
  app_secret      String?
  api_endpoint    String?
  access_token    String?  @db.Text
  refresh_token   String?  @db.Text
  token_expires   DateTime?
  extra_params    Json?    // 其他平台特定参数
  is_master       Int      @default(0) // [NEW] 是否为平台公共基础模版 (Section 4.4.2)
  status          Int      @default(1)

  @@index([platform_id, dept_id, shop_id])
}

model bi_order {
  id              String   @id @default(cuid())
  create_time     DateTime @default(now())
  update_time     DateTime @updatedAt
  is_deleted      Int      @default(0)
  platform_id     String
  dept_id         String
  shop_id         String?
  external_order_no String
  order_status    String
  order_amount    Decimal  @db.Decimal(10, 2)
  pay_amount      Decimal? @db.Decimal(10, 2)
  customer_name   String?
  customer_phone  String?
  address         String?  @db.Text
  order_time      DateTime
  pay_time        DateTime?
  raw_data        Json?    // 原始各平台 JSON 数据备查
  sync_status     Int      @default(1)

  @@unique([platform_id, shop_id, external_order_no])
  @@index([platform_id, dept_id, order_time])
}

// [NEW] 标准商品表 (Section 4.3)
model bi_product {
  id              String   @id @default(cuid())
  create_time     DateTime @default(now())
  update_time     DateTime @updatedAt
  is_deleted      Int      @default(0)
