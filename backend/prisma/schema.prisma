generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}
model knowledge_article {
  id              String   @id @default(cuid())
  create_time     DateTime @default(now())
  update_time     DateTime @updatedAt
  is_deleted      Int      @default(0)
  title           String
  content         String   @db.Text
  category_id     String?
  category_name   String?
  status          String   @default("draft")
  author_id       String?
  author_name     String?
  source_type     String?  // 'manual', 'document'
  source_ref      String?  // document_id
  keyword         String?
  attachment_urls Json?
  is_public       Int      @default(0) // 是否为公共
  platform_id     String
  dept_id         String
  shop_id         String?
  published_at    DateTime?

  @@index([platform_id, dept_id, is_deleted, status])
  @@index([category_id, is_deleted])
  @@index([keyword, is_deleted])
  @@index([source_type, source_ref])
}

model knowledge_document {
  id            String   @id @default(cuid())
  create_time   DateTime @default(now())
  update_time   DateTime @updatedAt
  is_deleted    Int      @default(0)
  file_name     String
  file_path     String   // MinIO bucket path
  file_size     Int
  file_type     String   // pdf, docx, xlsx, pptx
  status        String   @default("pending") // pending, processing, completed, failed
  progress      Int      @default(0) // 新增：处理进度 0-100
  content       String?  @db.LongText
 // 新增：存储解析后的全文内容
  error_msg     String?  @db.Text
  process_log   String?  @db.Text
  vector_ids    Json?    // Array of point IDs in Qdrant
  platform_id   String
  dept_id       String
  shop_id       String?
  uploader_id   String?
  is_public     Int      @default(0) // 是否为公共
  @@index([platform_id, dept_id, status])

  @@index([status, create_time])
}

model knowledge_chat_session {
  id            String   @id @default(cuid())
  create_time   DateTime @default(now())
  update_time   DateTime @updatedAt
  is_deleted    Int      @default(0)
  title         String
  user_id       String
  platform_id   String
  dept_id       String
  messages      knowledge_chat_message[]

  @@index([user_id, create_time])
  @@index([platform_id, dept_id])
}

model knowledge_chat_message {
  id          String   @id @default(cuid())
  create_time DateTime @default(now())
  session_id  String
  role        String   // user, assistant
  content     String   @db.Text
  references  Json?    // 引用知识点的 ID 列表
  session     knowledge_chat_session @relation(fields: [session_id], references: [id])

  @@index([session_id, create_time])
}

model knowledge_category {
  id              String   @id @default(cuid())
  create_time     DateTime @default(now())
  update_time     DateTime @updatedAt
  is_deleted      Int      @default(0)
  category_name   String
  category_code   String
  parent_id       String?
  level           Int      @default(1)
  sort            Int      @default(0)
  enabled         Int      @default(1)
  description     String?  @db.Text
  platform_id     String
  dept_id         String
  shop_id         String?

  @@unique([category_code, platform_id, dept_id, shop_id])
  @@index([platform_id, dept_id, shop_id, enabled, sort])
  @@index([parent_id, sort])
}
model approval_template {
  id              String   @id @default(cuid())
  create_time     DateTime @default(now())
  update_time     DateTime @updatedAt
  is_deleted      Int      @default(0)
  name            String
  type            String
  platform_id     String?
  platform_name   String
  dept_id         String?
  department_name String
  status          String   @default("enabled") // enabled, disabled
  description     String?  @db.Text
  updated_at      String   // 用于前端显示
  nodes           Json     // 流程节点定义
  form_fields     Json?    // [NEW] 自定义表单字段定义

  @@index([status, update_time])
}

model approval_request {
  id                    String   @id @default(cuid())
  create_time           DateTime @default(now())
  update_time           DateTime @updatedAt
  is_deleted            Int      @default(0)
  request_no            String   @unique
  template_id           String
  template_name         String
  biz_type              String?
  biz_id                String?
  biz_no                String?
  type                  String   // attendance, finance, general
  applicant_id          String
  applicant_name        String
  current_approver_id   String?
  current_approver_name String?
  current_node_id       String?  // [NEW] 当前执行到的节点 ID
  status                String   // pending, approved, rejected, withdrawn
  amount                Decimal? @db.Decimal(10, 2)
  platform_id           String?
  platform_name         String
  dept_id               String?
  department_name       String
  summary               String   @db.Text
  form_data             Json?    // [NEW] 提交的表单数据
  created_at            String   // 前端显示
  updated_at            String
  progress              Json     // 审批进度记录

  @@unique([biz_type, biz_id])
  @@index([status, update_time])
  @@index([applicant_id, update_time])
  @@index([current_approver_id, update_time])
}

model sys_user {
  id              String   @id @default(cuid())
  create_time     DateTime @default(now())
  update_time     DateTime @updatedAt
  is_deleted      Int      @default(0)
  username        String   @unique
  password        String
  name            String
  phone           String?
  email           String?
  status          Int      @default(1)
  last_login_time DateTime?
  platform_id     String?
  dept_id         String?
  shop_id         String?
  dept            biz_department? @relation("UserDepartment", fields: [dept_id], references: [id])
  roles           sys_user_role[]
  approved_registers sys_user_register[] @relation("RegisterApprover")

  @@index([platform_id, dept_id, status])
}

model biz_department {
  id              String   @id @default(cuid())
  create_time     DateTime @default(now())
  update_time     DateTime @updatedAt
  is_deleted      Int      @default(0)
  name            String
  code            String   @unique
  parent_id       String?
  sort            Int      @default(0)
  status          Int      @default(1)
  platform_id     String?
  owner_id        String?
  users           sys_user[] @relation("UserDepartment")
  registers       sys_user_register[]
}

model sys_role {
  id          String   @id @default(cuid())
  create_time DateTime @default(now())
  update_time DateTime @updatedAt
  is_deleted  Int      @default(0)
  role_name   String
  role_code   String   @unique
  description String?
  status      Int      @default(1)
  users       sys_user_role[]
  menus       sys_role_menu[]
  buttons     sys_role_button[]
}

model sys_user_role {
  id          String   @id @default(cuid())
  create_time DateTime @default(now())
  update_time DateTime @updatedAt
  user_id     String
  role_id     String
  user        sys_user @relation(fields: [user_id], references: [id])
  role        sys_role @relation(fields: [role_id], references: [id])

  @@unique([user_id, role_id])
}

model sys_api_permission {
  id              String   @id @default(cuid())
  create_time     DateTime @default(now())
  update_time     DateTime @updatedAt
  is_deleted      Int      @default(0)
  api_path        String   @unique
  request_method  String
  api_name        String
  role_ids        Json
  status          Int      @default(1)
  platform_id     String?
  dept_id         String?
  shop_id         String?

  @@index([api_path, status])
}

model sys_menu {
  id          String   @id @default(cuid())
  create_time DateTime @default(now())
  update_time DateTime @updatedAt
  is_deleted  Int      @default(0)
  menu_name   String
  menu_code   String   @unique
  parent_id   String?
  icon        String?
  route       String?  @unique
  sort        Int      @default(0)
  type        Int
  status      Int      @default(1)
  roles       sys_role_menu[]
  buttons     sys_button[]
}

model sys_button {
  id          String   @id @default(cuid())
  create_time DateTime @default(now())
  update_time DateTime @updatedAt
  is_deleted  Int      @default(0)
  button_name String
  button_code String   @unique
  menu_id     String
  status      Int      @default(1)
  menu        sys_menu @relation(fields: [menu_id], references: [id])
  roles       sys_role_button[]
}

model sys_role_menu {
  id          String   @id @default(cuid())
  create_time DateTime @default(now())
  update_time DateTime @updatedAt
  role_id     String
  menu_id     String
  role        sys_role @relation(fields: [role_id], references: [id])
  menu        sys_menu @relation(fields: [menu_id], references: [id])

  @@unique([role_id, menu_id])
}

model sys_role_button {
  id          String   @id @default(cuid())
  create_time DateTime @default(now())
  update_time DateTime @updatedAt
  role_id     String
  button_id   String
  role        sys_role @relation(fields: [role_id], references: [id])
  button      sys_button @relation(fields: [button_id], references: [id])

  @@unique([role_id, button_id])
}

model sys_login_log {
  id              String   @id @default(cuid())
  create_time     DateTime @default(now())
  update_time     DateTime @updatedAt
  is_deleted      Int      @default(0)
  user_id         String?
  username        String
  login_ip        String?
  user_agent      String?  @db.VarChar(512)
  login_status    Int      @default(1)
  login_message   String?
  platform_id     String?
  dept_id         String?
  shop_id         String?

  @@index([username, create_time])
  @@index([login_status, create_time])
  @@index([platform_id])
  @@index([user_id])
}

model sys_login_log_archive {
  id              String   @id @default(cuid())
  create_time     DateTime @default(now())
  update_time     DateTime @updatedAt
  is_deleted      Int      @default(0)
  user_id         String?
  username        String
  login_ip        String?
  user_agent      String?  @db.VarChar(512)
  login_status    Int      @default(1)
  login_message   String?
  platform_id     String?
  dept_id         String?
  shop_id         String?

  @@index([platform_id, create_time])
}

model sys_operation_log {
  id                String   @id @default(cuid())
  create_time       DateTime @default(now())
  update_time       DateTime @updatedAt
  is_deleted        Int      @default(0)
  user_id           String?
  username          String?
  request_method    String
  api_path          String
  api_name          String?
  operation_module  String?
  request_ip        String?
  user_agent        String?  @db.VarChar(512)
  operation_status  Int      @default(1)
  operation_message String?
  request_params    Json?
  response_summary  Json?
  diff_content      Json?    // [NEW] 字段级变更详情
  platform_id       String?
  dept_id           String?
  shop_id           String?

  @@index([platform_id, dept_id])
  @@index([user_id, create_time])
  @@index([operation_module, create_time])
  @@index([operation_status, create_time])
  @@index([create_time])
  @@index([username, create_time])
}

model sys_error_log {
  id                String   @id @default(cuid())
  create_time       DateTime @default(now())
  update_time       DateTime @updatedAt
  is_deleted        Int      @default(0)
  user_id           String?
  username          String?
  request_method    String?
  api_path          String?
  request_params    Json?
  error_message     String   @db.Text
  stack_trace       String?  @db.LongText
  platform_id       String?
  dept_id           String?

  @@index([create_time])
}

model sys_operation_log_archive {
  id                String   @id @default(cuid())
  create_time       DateTime @default(now())
  update_time       DateTime @updatedAt
  is_deleted        Int      @default(0)
  user_id           String?
  username          String?
  request_method    String
  api_path          String
  api_name          String?
  operation_module  String?
  request_ip        String?
  user_agent        String?  @db.VarChar(512)
  operation_status  Int      @default(1)
  operation_message String?
  request_params    Json?
  response_summary  Json?
  platform_id       String?
  dept_id           String?
  shop_id           String?

  @@index([platform_id, create_time])
  @@index([user_id, create_time])
}

model attendance_monthly_summary {
  id              String   @id @default(cuid())
  create_time     DateTime @default(now())
  update_time     DateTime @updatedAt
  is_deleted      Int      @default(0)
  employee_id     String
  month           String   // 格式：YYYY-MM
  normal_days     Int      @default(0)
  late_count      Int      @default(0)
  early_count     Int      @default(0)
  absent_days     Int      @default(0)
  miss_count      Int      @default(0)
  platform_id     String?
  dept_id         String?

  @@unique([employee_id, month])
  @@index([platform_id, dept_id, month])
}

model biz_platform {
  id          String   @id @default(cuid())
  create_time DateTime @default(now())
  update_time DateTime @updatedAt
  is_deleted  Int      @default(0)
  name        String
  code        String   @unique
  description String?  @db.Text
  status      Int      @default(1)
  owner_id    String?
}

model biz_shop {
  id              String   @id @default(cuid())
  create_time     DateTime @default(now())
  update_time     DateTime @updatedAt
  is_deleted      Int      @default(0)
  name            String
  code            String   @unique
  type            Int      @default(1)
  address         String?  @db.Text
  phone           String?
  avatar          String?
  description     String?  @db.Text
  platform_id     String
  department_id   String
  owner_id        String?
  status          Int      @default(1)
  sort            Int      @default(0)

  @@index([platform_id, department_id, status])
  @@index([sort])
}

model hr_employee {
  id                    String   @id @default(cuid())
  create_time           DateTime @default(now())
  update_time           DateTime @updatedAt
  is_deleted            Int      @default(0)
  name                  String
  gender                Int?
  age                   Int?
  phone                 String?
  email                 String?
  employee_no           String?  @unique
  job_no                String?  @unique
  department_id         String?
  position_id           String?
  user_id               String?  @unique
  manager_employee_id   String?
  platform_id           String?
  status                Int      @default(1)
  join_date             DateTime?
  regularization_date   DateTime?
  contract_expire_time  DateTime?
  id_card_front_file    String?
  id_card_back_file     String?
  emergency_contact_name  String?
  emergency_contact_phone String?
  household_registration String?
  political_status      String?
  education             String?
  graduate_school       String?
  major                 String?
  social_security_base  Decimal? @db.Decimal(10, 2)
  social_security_city  String?
}

model attendance_record {
  id                     String   @id @default(cuid())
  create_time            DateTime @default(now())
  update_time            DateTime @updatedAt
  is_deleted             Int      @default(0)
  employee_id            String
  attendance_date        DateTime
  schedule_id            String?
  shift_name             String?
  scheduled_on_duty_time String?
  scheduled_off_duty_time String?
  actual_on_duty_time    DateTime?
  actual_off_duty_time   DateTime?
  on_duty_location       String?
  off_duty_location      String?
  on_duty_status         Int      @default(0)
  off_duty_status        Int      @default(0)
  work_duration_minutes  Int?
  exception_type         String?
  remark                 String?
  platform_id            String?
  dept_id                String?

  @@index([employee_id, attendance_date])
  @@index([platform_id, dept_id, attendance_date])
}

model attendance_schedule {
  id            String   @id @default(cuid())
  create_time   DateTime @default(now())
  update_time   DateTime @updatedAt
  is_deleted    Int      @default(0)
  employee_id   String
  schedule_date DateTime
  shift_name    String
  dept_id       String?
  status        Int      @default(0) // 0: 待发布, 1: 已发布
  publish_time  DateTime?

  @@index([employee_id, schedule_date])
  @@index([dept_id, schedule_date])
}

model sys_config {
  id           String   @id @default(cuid())
  create_time  DateTime @default(now())
  update_time  DateTime @updatedAt
  is_deleted   Int      @default(0)
  config_key   String   @unique
  config_value String   @db.Text
  remark       String?  @db.Text
}

model attendance_leave {
  id                  String   @id @default(cuid())
  create_time         DateTime @default(now())
  update_time         DateTime @updatedAt
  is_deleted          Int      @default(0)
  leave_no            String   @unique
  employee_id         String
  leave_type          String
  start_time          DateTime
  end_time            DateTime
  duration_hours      Decimal? @db.Decimal(10, 2)
  reason              String?
  approval_status     Int      @default(0)
  approved_by         String?
  approved_time       DateTime?
  platform_id         String?
  dept_id             String?
  sync_attendance     Int      @default(0)
  sync_schedule       Int      @default(0)
  approval_request_id String?
  approval_request_no String?
  attachment_urls     Json?

  @@index([employee_id, start_time])
  @@index([approval_status, start_time])
  @@index([approval_request_id])
}

model attendance_overtime {
  id                  String   @id @default(cuid())
  create_time         DateTime @default(now())
  update_time         DateTime @updatedAt
  is_deleted          Int      @default(0)
  overtime_no         String   @unique
  employee_id         String
  start_time          DateTime
  end_time            DateTime
  duration_hours      Decimal? @db.Decimal(10, 2)
  reason              String?
  approval_status     Int      @default(0)
  approved_by         String?
  approved_time       DateTime?
  platform_id         String?
  dept_id             String?
  sync_attendance     Int      @default(0)
  sync_schedule       Int      @default(0)
  approval_request_id String?
  approval_request_no String?
  attachment_urls     Json?

  @@index([employee_id, start_time])
  @@index([approval_status, start_time])
  @@index([approval_request_id])
}

model attendance_patch_card {
  id                  String   @id @default(cuid())
  create_time         DateTime @default(now())
  update_time         DateTime @updatedAt
  is_deleted          Int      @default(0)
  patch_no            String   @unique
  employee_id         String
  patch_date          DateTime
  patch_type          String
  target_time         DateTime
  reason              String?
  approval_status     Int      @default(0)
  approved_by         String?
  approved_time       DateTime?
  platform_id         String?
  dept_id             String?
  sync_attendance     Int      @default(0)
  approval_request_id String?
  approval_request_no String?
  attachment_urls     Json?

  @@index([employee_id, patch_date])
  @@index([approval_status, patch_date])
  @@index([approval_request_id])
}

model attendance_schedule_change {
  id                String   @id @default(cuid())
  create_time       DateTime @default(now())
  update_time       DateTime @updatedAt
  is_deleted        Int      @default(0)
  change_no         String   @unique
  employee_id       String
  change_date       DateTime
  before_shift_name String?
  after_shift_name  String?
  change_type       String
  reason            String?
  operator_id       String?
  notify_status     Int      @default(0)
  platform_id       String?
  dept_id           String?

  @@index([employee_id, change_date])
  @@index([notify_status, change_date])
}

model attendance_staffing_demand {
  id              String   @id @default(cuid())
  create_time     DateTime @default(now())
  update_time     DateTime @updatedAt
  is_deleted      Int      @default(0)
  platform_id     String
  dept_id         String
  date            DateTime
  shift_name      String
  required_count  Int      @default(0)
  expected_volume Int?     @default(0) // 预期业务量/客流

  @@unique([dept_id, date, shift_name, is_deleted])
  @@index([platform_id, dept_id, date])
}

model sys_message {
  id           String    @id @default(cuid())
  create_time  DateTime  @default(now())
  update_time  DateTime  @updatedAt
  is_deleted   Int       @default(0)
  delete_time  DateTime? // 回收站逻辑删除时间 (PRD 2.3.2)
  is_favorite  Int       @default(0) // 收藏标记 (PRD 2.3.2)
  recipient_id String
  title        String
  content      String    @db.Text
  message_type String
  biz_type     String?
  biz_id       String?
  route        String?
  read_status  Int       @default(0)
  read_time    DateTime?
  sender_id    String?
  sender_name  String?
  payload      Json?
  delivery_channels Json? // 外部渠道发送状态 (sms, email)

  @@index([recipient_id, read_status, create_time])
}

model sys_external_api_key {
  id           String   @id @default(cuid())
  create_time  DateTime @default(now())
  update_time  DateTime @updatedAt
  is_deleted   Int      @default(0)
  name         String
  service_type String
  api_key      String   @db.VarChar(512)
  api_secret   String?  @db.VarChar(512)
  endpoint     String?  @db.VarChar(512)
  platform_id  String
  dept_id      String?
  status       Int      @default(1)

  @@index([platform_id, dept_id, service_type])
}

model sys_api_mapping {
  id           String   @id @default(cuid())
  create_time  DateTime @default(now())
  update_time  DateTime @updatedAt
  is_deleted   Int      @default(0)
  source_name  String
  api_endpoint String
  method       String   @default("GET")
  mapping_json Json
  platform_id  String
  status       Int      @default(1)

  @@index([platform_id, source_name])
}

model fin_expense_type {
  id          String   @id @default(cuid())
  create_time DateTime @default(now())
  update_time DateTime @updatedAt
  is_deleted  Int      @default(0)
  name        String
  code        String
  description String?  @db.Text
  platform_id String
  dept_id     String?
  status      Int      @default(1)

  @@unique([code, platform_id])
}

model fin_reimbursement {
  id                  String   @id @default(cuid())
  create_time         DateTime @default(now())
  update_time         DateTime @updatedAt
  is_deleted          Int      @default(0)
  reim_no             String   @unique
  expense_type_id     String
  amount              Decimal  @db.Decimal(10, 2)
  reason              String   @db.Text
  attachment_urls     Json?
  applicant_id        String
  platform_id         String
  dept_id             String
  shop_id             String?
  approval_request_id String?
  status              Int      @default(1) // 1:审批中, 2:待打款, 3:已打款, 4:已驳回, 5:已撤回
  paid_at             DateTime?
  pay_method          String?   // 银行转账, 支付宝, 微信, 现金
  remark              String?   @db.Text

  @@index([platform_id, dept_id, status])
}

model fin_purchase {
  id                  String   @id @default(cuid())
  create_time         DateTime @default(now())
  update_time         DateTime @updatedAt
  is_deleted          Int      @default(0)
  purchase_no         String   @unique
  items               Json
  total_amount        Decimal  @db.Decimal(10, 2)
  actual_amount       Decimal? @db.Decimal(10, 2) // [NEW] 实际采购金额
  reason              String   @db.Text
  attachment_urls     Json?
  applicant_id        String
  platform_id         String
  dept_id             String
  shop_id             String?
  approval_request_id String?
  status              Int      @default(1) // 1:审批中, 2:待采购, 3:已完成, 4:已驳回, 5:已取消
  supplier_info       String?  @db.Text
  completed_at        DateTime?

  @@index([platform_id, dept_id, status])
}

model fin_cash_record {
  id          String   @id @default(cuid())
  create_time DateTime @default(now())
  update_time DateTime @updatedAt
  is_deleted  Int      @default(0)
  type        Int      // 1: 收入, 2: 支出
  amount      Decimal  @db.Decimal(10, 2)
  source      String   // 来源说明
  biz_id      String?  // 关联业务 ID
  biz_type    String?  // reimbursement, purchase, manual
  biz_no      String?  // [NEW] 关联业务单号
  platform_id String
  dept_id     String
  shop_id     String?
  operator_id String?  // 操作人
  remark      String?  @db.Text
  modify_log  Json?    // [NEW] 修改日志

  @@index([platform_id, dept_id, type])
}

model hr_position {
  id            String   @id @default(cuid())
  create_time   DateTime @default(now())
  update_time   DateTime @updatedAt
  is_deleted    Int      @default(0)
  name          String
  code          String   @unique
  description   String?
  department_id String
  level         Int?
  sequence      String?
  platform_id   String?
}

model attendance_rule {
  id                    String   @id @default(cuid())
  create_time           DateTime @default(now())
  update_time           DateTime @updatedAt
  is_deleted            Int      @default(0)
  name                  String
