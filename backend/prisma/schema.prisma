  trigger_keywords     Json?
  response_timeout_sec Int?
  enabled              Int      @default(1)
  sort                 Int      @default(0)
  platform_id          String
  dept_id              String
  shop_id              String?
  created_by           String?

  @@index([platform_id, dept_id, shop_id, enabled, sort])
}

model service_sensitive_term {
  id          String   @id @default(cuid())
  create_time DateTime @default(now())
  update_time DateTime @updatedAt
  is_deleted  Int      @default(0)
  term        String
  category    String
  severity    Int      @default(1)
  enabled     Int      @default(1)
  replace_text String?
  description String?  @db.Text
  platform_id String
  dept_id     String
  shop_id     String?
  created_by  String?

  @@unique([term, platform_id, dept_id, shop_id])
}

model service_session_analysis {
  id                     String   @id @default(cuid())
  create_time            DateTime @default(now())
  update_time            DateTime @updatedAt
  is_deleted             Int      @default(0)
  session_id             String
  session_no             String
  platform_id            String
  dept_id                String
  shop_id                String?
  triggered_by           String   @default("system")
  triggered_by_user_id   String?
  quality_score          Int      @default(100)
  quality_passed         Int      @default(1)
  loss_risk_level        String   @default("low")
  loss_risk_score        Int      @default(0)
  customer_sentiment     String   @default("neutral")
  response_timeout_count Int      @default(0)
  sensitive_hit_count    Int      @default(0)
  faq_hit_count          Int      @default(0)
  top_faqs               Json?
  sensitive_hits         Json?
  triggered_rule_ids     Json?
  summary                String?  @db.Text
  suggestions            Json?
  analyzed_at            DateTime @default(now())

  @@index([session_id, analyzed_at])
  @@index([platform_id, dept_id, loss_risk_level])
  @@index([quality_passed, analyzed_at])
}

model service_quality_record {
  id                   String   @id @default(cuid())
  create_time          DateTime @default(now())
  update_time          DateTime @updatedAt
  is_deleted           Int      @default(0)
  session_id           String
  analysis_id          String?
  session_no           String
  inspector_id         String?
