  platform_id          String
  dept_id              String
  shop_id              String?
  rectification_status String   @default("not_required")
  rectification_note   String?  @db.Text
  inspected_at         DateTime @default(now())

  @@index([session_id, inspected_at])
  @@index([platform_id, dept_id, inspected_at])
  @@index([passed, inspected_at])
}

model service_satisfaction {
