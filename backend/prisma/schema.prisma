// 系统配置表（权限优化专用）
model sys_permission_config {
  id           String   @id @default(cuid())
  create_time  DateTime @default(now())
  update_time  DateTime @updatedAt
  config_key   String   @unique
  config_value String   @db.Text
  config_type  String   // string/number/boolean/json
  description  String?
}

// 权限模板表
model sys_permission_template {
  id                String   @id @default(cuid())
  create_time       DateTime @default(now())
  update_time       DateTime @updatedAt
  is_deleted        Int      @default(0)
  template_name     String
  template_type     String   // system/custom
  description       String?  @db.Text
  permission_config Json     // 权限配置
  is_default        Int      @default(0)
  category          String?  // 分类（部门/岗位）
  created_by        String?
  platform_id       String?
  dept_id           String?

  @@unique([template_name, is_deleted])
  @@index([template_type, is_deleted])
  @@index([category, is_deleted])
}

// 员工履历表
model hr_employee_history {
  id              String   @id @default(cuid())
  create_time     DateTime @default(now())
  update_time     DateTime @updatedAt
  is_deleted      Int      @default(0)
  employee_id     String
  event_type      String   // onboard(入职), transfer(调岗), promotion(晋升), regularization(转正), resignation(离职), status_change(状态变更)
  event_date      DateTime
  before_data     Json?
  after_data      Json?
  department_id   String?
  position_id     String?
  remark          String?  @db.Text
  operator_id     String?
  operator_name   String?
  platform_id     String?

  @@index([employee_id, event_date])
  @@index([event_type])
  @@index([platform_id])
}

// 用户注册申请表
model sys_user_register {
  id            String    @id @default(cuid())
  create_time   DateTime  @default(now())
  update_time   DateTime  @updatedAt
  is_deleted    Int       @default(0)
  name          String
  phone         String
  dept_id       String
  password      String
  status        String    @default("pending") // pending, approved, rejected
  reject_reason String?   @db.Text
  approve_time  DateTime?
  approver_id   String?
  platform_id   String?

  biz_department biz_department? @relation(fields: [dept_id], references: [id])
  approver       sys_user?       @relation("RegisterApprover", fields: [approver_id], references: [id])

  @@index([phone, status])
  @@index([status, create_time])
  @@index([platform_id, dept_id])
}
