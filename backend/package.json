{
  "name": "aisystem-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start:dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/src/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "verify:permissions": "ts-node ../scripts/verify-permissions.ts",
    "analyze:large-files": "ts-node ../scripts/analyze-large-files.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "ts-node prisma/seed.ts",
    "cleanup": "ts-node scripts/cleanup/index.ts run",
    "cleanup:dry-run": "ts-node scripts/cleanup/index.ts run --dry-run",
    "cleanup:restore": "ts-node scripts/cleanup/index.ts restore",
    "cleanup:list-backups": "ts-node scripts/cleanup/index.ts list-backups"
  },
